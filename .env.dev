# Local development environment for `docker compose --env-file .env.dev ...`.
#
# Values here are intentionally weak and public: this file exists so a new contributor can run the
# whole platform with one command. Never reuse any of these values outside a laptop.

SPRING_PROFILES_ACTIVE=dev

# Compose uses this file twice: `--env-file` for ${...} interpolation, and `env_file:` to inject
# the values into the containers. ENV_FILE points the second at this same file.
ENV_FILE=.env.dev

CONFIG_SERVER_URL=http://config-service:8888
EUREKA_SERVER_URL=http://discovery-service:8761/eureka
EUREKA_PREFER_IP=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rootroot
CUSTOMER_DB_NAME=user_db
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=rootroot

MAIL_HOST=mail-dev
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@ecommerce.local

JWT_SECRET=I_gu6p0FVNHP_Hhjt0cHXF-eFwYGB8ph1xwUOKaBYljDfsXnHpfYAYgaRC8msRTc
JWT_ISSUER=ecommerce-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=15m

DB_POOL_MAX=10
DB_POOL_MIN_IDLE=5
CACHE_ENABLED=true
GATEWAY_TIMEOUT=5s
SECURITY_LOG_LEVEL=debug
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC


