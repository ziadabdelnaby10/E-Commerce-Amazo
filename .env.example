# Template for the environment files consumed by docker compose.
#
# Copy to .env.dev / .env.prod and fill in real values. Both of those are git-ignored: the JWT
# signing key and database password must never be committed, because anyone holding the signing
# key can mint a token for any user with any role.
#
#   copy .env.example .env.dev      (Windows)
#   cp   .env.example .env.dev      (macOS/Linux)

# ---------- Runtime profile ----------
# dev  -> verbose logging, SQL echo, all actuator endpoints exposed
# prod -> minimal logging, only health/info/prometheus exposed
SPRING_PROFILES_ACTIVE=dev

# Compose uses this file twice: `--env-file` supplies variables for ${...} interpolation, while
# `env_file:` injects them into the containers. ENV_FILE points the second at the same file, so
# both always agree. Set it to the name of THIS file whenever you copy it.
ENV_FILE=.env.example

# ---------- Platform wiring (container hostnames) ----------
CONFIG_SERVER_URL=http://config-service:8888
EUREKA_SERVER_URL=http://discovery-service:8761/eureka
# Containers get a random hostname, so instances must register by IP to be reachable.
EUREKA_PREFER_IP=true

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
CUSTOMER_DB_NAME=user_db
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# ---------- Kafka ----------
# Use the internal listener: 9092 is advertised as localhost and only works from the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ---------- Mail ----------
MAIL_HOST=mail-dev
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@ecommerce.local

# ---------- Security ----------
# Must be at least 32 bytes for HS256. Generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_SECRET_VALUE
JWT_ISSUER=ecommerce-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=15m

# ---------- Tuning ----------
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=5
CACHE_ENABLED=true
GATEWAY_TIMEOUT=5s
JAVA_OPTS=-XX:MaxRAMPercentage=75

